    "bench:compare": "node dist/src/tools/compare_benchmarks.js"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "src/plugins/*"
  ]
