  "scripts": {
    "build:plugins": "yarn workspace @veramo-community/kms-local-bls build && yarn workspace @veramo-community/did-manager-bls build && yarn workspace @veramo-community/did-provider-ethr-bls build && yarn workspace @veramo-community/credential-w3c-bls-multisig build",
    "build": "yarn build:plugins && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "server:build": "yarn build",
    "server:start": "node dist/src/server-demo/veramo-server.js",
