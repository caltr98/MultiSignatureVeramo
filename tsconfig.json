{
  "compilerOptions": {
    "preserveConstEnums": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": "./",
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "downlevelIteration": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "server/**/*.ts", "validation/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/plugins/**/build/**"]
}
